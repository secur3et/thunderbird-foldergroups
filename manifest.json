{
  "manifest_version": 2,
  "name": "Account Folder Manager",
  "description": "Organize your Thunderbird email accounts into custom groups with a tab interface and email viewer.",
  "version": "1.0.0",
  "author": "secur3-et",
  "homepage_url": "https://github.com/secur3-et/thunderbird-foldergroups",
  "browser_specific_settings": {
    "gecko": {
      "id": "account-folder-manager@thunderbird.extension",
      "strict_min_version": "91.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Account Groups"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

